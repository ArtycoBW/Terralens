# Локальный Compose. Для внешнего размещения задать отдельные секреты и HTTPS.
POSTGRES_PASSWORD=terralens
DJANGO_SECRET_KEY=replace-with-a-random-secret-before-public-deployment
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:8000
COOKIE_SECURE=false
MAX_SCENES=80
MAX_ACTIVE_JOBS=3
MAX_POLYGON_AREA_HA=10000
MAX_VERTICES=5000
MAX_POLYGONS=20
MAX_PERIOD_DAYS=366
WORKSPACE_DAYS=7
EXPORT_DAYS=1
SNAPSHOT_RETENTION_DAYS=30
ARTIFACT_ORPHAN_GRACE_HOURS=24
# Без Compose: DATABASE_URL=postgis://terralens:terralens@127.0.0.1:54329/terralens
# Без Compose: REDIS_URL=redis://127.0.0.1:56379/0
# GEE не включён: Earth Search C1 + Planetary Computer Landsat + Open-Meteo ERA5-Seamless.
