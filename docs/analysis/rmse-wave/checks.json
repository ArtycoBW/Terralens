{
  "ruff-check": {
    "command": [
      ".venv/bin/ruff",
      "check",
      "ml",
      "backend",
      "scripts"
    ],
    "returncode": 0,
    "output": "ruff-check.txt"
  },
  "ruff-format": {
    "command": [
      ".venv/bin/ruff",
      "format",
      "--check",
      "ml",
      "backend",
      "scripts"
    ],
    "returncode": 0,
    "output": "ruff-format.txt"
  },
  "pytest": {
    "command": [
      ".venv/bin/pytest",
      "-q"
    ],
    "returncode": 0,
    "output": "pytest.txt"
  }
}
